@model List<JoyRiseFitness.Models.Workout>
@if (!Model.Any())
{
    <p>暂无计划，快去生成吧！</p>
}
else
{
    <div class="my-plan-list">
        @foreach (var w in Model)
        {
            <!-- 单个卡片容器 -->
            <div class="plan-item">
                <!-- 点击区域：跳转器材详情 -->
                <a href="@Url.Action("Detail", "Equipment", new { id = w.Id })" class="plan-card">
                    <img src="@w.ImgUrl" alt="@w.Name" />
                    <h4>@w.Name</h4>
                    <span>@w.Part · @w.Difficulty</span>
                </a>
                <!-- 独立删除按钮 -->
                <button class="del-btn" onclick="delPlan(@w.Id)">删除</button>
            </div>
        }
    </div>
}